pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building ML Model Analysis application...'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'where python'
                bat 'where pip'
                bat 'C:\\Python314\\python.exe --version'
                bat 'C:\\Python314\\python.exe -m pip --version'
                bat 'C:\\Python314\\python.exe -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                bat 'C:\\Python314\\python.exe -m py_compile main.py'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                if not exist C:\\xampp\\htdocs\\ml_model mkdir C:\\xampp\\htdocs\\ml_model
                xcopy /E /Y /I * C:\\xampp\\htdocs\\ml_model
                '''
            }
        }

        stage('Stop Old Streamlit') {
            steps {
                bat '''
                for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8501 ^| findstr LISTENING') do taskkill /PID %%a /F >nul 2>&1
                exit /b 0
                '''
            }
        }

        stage('Start Streamlit') {
            steps {
                bat '''
                if exist C:\\xampp\\htdocs\\ml_model\\streamlit.log del C:\\xampp\\htdocs\\ml_model\\streamlit.log

                start "ML Model Analysis" /MIN cmd /c "C:\\Python314\\python.exe -m streamlit run C:\\xampp\\htdocs\\ml_model\\main.py --server.headless true --server.address 0.0.0.0 > C:\\xampp\\htdocs\\ml_model\\streamlit.log 2>&1"

                timeout /t 5 /nobreak >nul
                '''
            }
        }

        stage('Verify Application') {
            steps {
                bat '''
                powershell -NoProfile -Command "try { Invoke-WebRequest -Uri http://localhost:8501 -UseBasicParsing -TimeoutSec 10 | Out-Null; Write-Host 'Streamlit application is running successfully.' } catch { Write-Error 'Streamlit application failed to start.'; exit 1 }"
                '''
            }
        }
    }
}
