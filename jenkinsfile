pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building ML Model Analysis application...'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'where python'
                bat 'where pip'
                bat 'C:\\Python314\\python.exe --version'
                bat 'C:\\Python314\\python.exe -m pip --version'
                bat 'C:\\Python314\\python.exe -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                bat 'C:\\Python314\\python.exe -m py_compile main.py'
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                if not exist C:\\xampp\\htdocs\\ml_model mkdir C:\\xampp\\htdocs\\ml_model
                xcopy /E /Y /I * C:\\xampp\\htdocs\\ml_model
                '''
            }
        }

        stage('Stop Old Streamlit') {
            steps {
                bat '''
                for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8501 ^| findstr LISTENING') do taskkill /PID %%a /F >nul 2>&1
                exit /b 0
                '''
            }
        }

        stage('Start Streamlit') {
    steps {
        bat '''
        if exist C:\\xampp\\htdocs\\ml_model\\streamlit.log del C:\\xampp\\htdocs\\ml_model\\streamlit.log

        powershell -NoProfile -Command "Start-Process -FilePath 'C:\\Python314\\python.exe' -ArgumentList '-m streamlit run C:\\xampp\\htdocs\\ml_model\\main.py --server.headless true --server.address 0.0.0.0 --server.port 8501' -WorkingDirectory 'C:\\xampp\\htdocs\\ml_model' -WindowStyle Hidden -RedirectStandardOutput 'C:\\xampp\\htdocs\\ml_model\\streamlit.log' -RedirectStandardError 'C:\\xampp\\htdocs\\ml_model\\streamlit.log'"

        exit /b 0
        '''
    }
}

        stage('Verify Application') {
            steps {
                bat '''
                powershell -NoProfile -Command "$ok=$false; for($i=0;$i -lt 12;$i++){ try { $r=Invoke-WebRequest -Uri 'http://localhost:8501' -UseBasicParsing -TimeoutSec 3; if($r.StatusCode -eq 200){$ok=$true; break} } catch {} ; Start-Sleep -Seconds 2 }; if($ok){Write-Host 'Streamlit application is running successfully.'} else {Write-Host 'Streamlit failed to start.'; if(Test-Path 'C:\\xampp\\htdocs\\ml_model\\streamlit.log'){Get-Content 'C:\\xampp\\htdocs\\ml_model\\streamlit.log'}; exit 1}"
                '''
            }
        }
    }
}
