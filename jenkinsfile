pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building ML Model Analysis application...'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'where python'
                bat 'where pip'
                bat 'C:\\Python314\\python.exe --version'
                bat 'C:\\Python314\\python.exe -m pip --version'
                bat 'C:\\Python314\\python.exe -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                bat 'C:\\Python314\\python.exe -m py_compile main.py'
            }
        }

        stage('Deploy') {
            steps {
                bat 'if not exist C:\\xampp\\htdocs\\ml_model mkdir C:\\xampp\\htdocs\\ml_model'
                bat 'xcopy /E /Y /I * C:\\xampp\\htdocs\\ml_model'
            }
        }
stage('Start Streamlit') {
    steps {
        bat '''
        start "ML Model Analysis" /B C:\\Python314\\python.exe -m streamlit run C:\\xampp\\htdocs\\ml_model\\main.py --server.headless true
        '''
    }
}
    }
}
